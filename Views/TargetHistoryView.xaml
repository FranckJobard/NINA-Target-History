<UserControl x:Class="NINA.TargetHistory.Views.TargetHistoryView" Loaded="TargetHistoryView_Loaded"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:NINA.TargetHistory.Models">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="LimeVisibilitySwitch" TargetType="{x:Type CheckBox}">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type CheckBox}">
      <Border x:Name="SwitchBorder" Background="Transparent" BorderBrush="Lime" BorderThickness="1" CornerRadius="10" Padding="0" Width="40" Height="20">
       <TextBlock x:Name="SwitchLabel" Text="OFF" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="Lime"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="SwitchBorder" Property="Background" Value="Lime"/>
        <Setter TargetName="SwitchLabel" Property="Text" Value="ON"/>
        <Setter TargetName="SwitchLabel" Property="Foreground" Value="Black"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="YellowVisibilitySwitch" TargetType="{x:Type CheckBox}">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type CheckBox}">
      <Border x:Name="SwitchBorder" Background="Transparent" BorderBrush="Yellow" BorderThickness="1" CornerRadius="10" Padding="0" Width="40" Height="20">
       <TextBlock x:Name="SwitchLabel" Text="OFF" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="Yellow"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="SwitchBorder" Property="Background" Value="Yellow"/>
        <Setter TargetName="SwitchLabel" Property="Text" Value="ON"/>
        <Setter TargetName="SwitchLabel" Property="Foreground" Value="Black"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ColoredCollapseToggle" TargetType="{x:Type ToggleButton}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ToggleButton}">
      <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
       <TextBlock x:Name="Arrow" Text="▼" Foreground="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"/>
       <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="False">
        <Setter TargetName="Arrow" Property="Text" Value="▶"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition>
    <RowDefinition.Style>
     <Style TargetType="RowDefinition">
      <Setter Property="Height" Value="*"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsChecked, ElementName=ImagedExpanded}" Value="False">
        <Setter Property="Height" Value="Auto"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </RowDefinition.Style>
   </RowDefinition>
   <RowDefinition Height="Auto"/>
   <RowDefinition>
    <RowDefinition.Style>
     <Style TargetType="RowDefinition">
      <Setter Property="Height" Value="*"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsChecked, ElementName=PlannedExpanded}" Value="False">
        <Setter Property="Height" Value="Auto"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </RowDefinition.Style>
   </RowDefinition>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <TextBox Grid.Column="0" MaxWidth="420" HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="8,5"
            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Search target"/>
   <ComboBox Grid.Column="1" Width="120" Margin="0,0,8,0"
             SelectedValuePath="Content" SelectedValue="{Binding Status}">
    <ComboBoxItem Content="All"/>
    <ComboBoxItem Content="In progress"/>
    <ComboBoxItem Content="Finished"/>
   </ComboBox>
   <Button Grid.Column="2" Content="Sequences folder…" Padding="10,4"
           Command="{Binding BrowseCommand}"/>
  </Grid>

  <TextBlock Grid.Row="1" Margin="0,8,0,8" VerticalAlignment="Center"
             Text="{Binding SequenceFolder}" TextTrimming="CharacterEllipsis"/>

  <DockPanel Grid.Row="2" Margin="0,0,0,4" VerticalAlignment="Top">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="Show historical fields" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <CheckBox IsChecked="{Binding ShowHistoricalFields, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LimeVisibilitySwitch}"
              VerticalAlignment="Center" Focusable="False"/>
   </StackPanel>
   <ToggleButton x:Name="ImagedExpanded" IsChecked="True" Content="Imaged targets" Foreground="Lime" Style="{StaticResource ColoredCollapseToggle}" VerticalAlignment="Center" ToolTip="Expand or collapse imaged targets"/>
  </DockPanel>
  <DataGrid x:Name="ImagedTargetsGrid" Grid.Row="2" Visibility="{Binding IsChecked, ElementName=ImagedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,26,0,0" ItemsSource="{Binding ImagedTargets}" AutoGenerateColumns="False"
            IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column"
            GridLinesVisibility="None" SelectionMode="Single" VerticalContentAlignment="Center"
            RowHeight="18" MouseDoubleClick="TargetGrid_MouseDoubleClick" SelectionChanged="TargetGrid_SelectionChanged" LostKeyboardFocus="TargetGrid_LostKeyboardFocus" Sorting="ImagedTargetsGrid_Sorting">
   <DataGrid.Resources>
    <Style TargetType="{x:Type DataGridCell}"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Target" Binding="{Binding Name}" IsReadOnly="True" CanUserSort="True" SortMemberPath="Name" Width="2*">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="Profile" Width="135" CanUserSort="False">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <ComboBox ItemsSource="{Binding DataContext.AvailableProfiles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                 DisplayMemberPath="Name" SelectedValuePath="Id"
                 SelectedValue="{Binding ProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Choose the N.I.N.A. profile used for this target"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Width (px)" Binding="{Binding ProfileSensorWidthPixels, StringFormat={}{0:0}}" IsReadOnly="True" SortMemberPath="ProfileSensorWidthPixels" Width="85"/>
    <DataGridTextColumn Header="Height (px)" Binding="{Binding ProfileSensorHeightPixels, StringFormat={}{0:0}}" IsReadOnly="True" SortMemberPath="ProfileSensorHeightPixels" Width="85"/>
    <DataGridTextColumn Header="Pixel size (µm)" Binding="{Binding ProfilePixelSizeMicrons, StringFormat={}{0:0.##}}" IsReadOnly="True" SortMemberPath="ProfilePixelSizeMicrons" Width="100"/>
    <DataGridTextColumn Header="Focal length (mm)" Binding="{Binding ProfileFocalLengthMm, StringFormat={}{0:0.##}}" IsReadOnly="True" SortMemberPath="ProfileFocalLengthMm" Width="120"/>
    <DataGridTemplateColumn Header="Exposures" CanUserSort="False" Width="4*">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <ItemsControl ItemsSource="{Binding Filters}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Margin="0,0,8,0">
           <TextBlock>
            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Display, Mode=OneWay}"/>
           </TextBlock>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" IsReadOnly="True" CanUserSort="True" SortMemberPath="TotalSeconds" Width="90">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="Finished" CanUserSort="False" Width="75">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Finished, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Focusable="False"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Web image link" Binding="{Binding AstroBinUrl, Mode=TwoWay}" CanUserSort="False" Width="2*">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
     <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.EditingElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="" CanUserSort="False" Width="70">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <Button Content="Open" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}"
        Command="{Binding DataContext.OpenAstroBinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
        CommandParameter="{Binding}"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="3" Margin="0,10,0,4">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="Show planned fields" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <CheckBox IsChecked="{Binding ShowPlannedFields, Mode=TwoWay}" Style="{StaticResource YellowVisibilitySwitch}"
              VerticalAlignment="Center" Focusable="False"/>
   </StackPanel>
   <ToggleButton x:Name="PlannedExpanded" IsChecked="True" Content="Planned targets" Foreground="Yellow" Style="{StaticResource ColoredCollapseToggle}" VerticalAlignment="Center" ToolTip="Expand or collapse planned targets"/>
  </DockPanel>
  <DataGrid x:Name="PlannedTargetsGrid" Grid.Row="4" Visibility="{Binding IsChecked, ElementName=PlannedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" ItemsSource="{Binding PlannedTargets}" AutoGenerateColumns="False"
            IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
            GridLinesVisibility="None" SelectionMode="Single"
            VerticalContentAlignment="Center" RowHeight="18" MouseDoubleClick="TargetGrid_MouseDoubleClick" SelectionChanged="TargetGrid_SelectionChanged" LostKeyboardFocus="TargetGrid_LostKeyboardFocus" Sorting="ImagedTargetsGrid_Sorting">
   <DataGrid.Resources>
    <Style TargetType="{x:Type DataGridCell}">
     <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Target" Binding="{Binding Name}" SortMemberPath="Name" Width="2*">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Date" Binding="{Binding MostRecentSequenceUtc, StringFormat={}{0:yyyy-MM-dd}}" SortMemberPath="MostRecentSequenceUtc" Width="110">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
